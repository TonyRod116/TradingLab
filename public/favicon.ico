<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="32" height="32">
  <!-- Background -->
  <rect width="32" height="32" fill="#1a1a1a" rx="4"/>
  
  <!-- Trading chart bars - simplified -->
  <!-- Green bars (upward trend) -->
  <rect x="4" y="22" width="3" height="6" fill="#00ff88"/>
  <rect x="8" y="20" width="3" height="8" fill="#00ff88"/>
  <rect x="12" y="18" width="3" height="10" fill="#00ff88"/>
  
  <!-- Red bars (downward trend) -->
  <rect x="16" y="24" width="3" height="4" fill="#ff4444"/>
  <rect x="20" y="26" width="3" height="2" fill="#ff4444"/>
  
  <!-- Trend line -->
  <path d="M5.5 25 L9.5 23 L13.5 21 L17.5 25 L21.5 27" stroke="#ffffff" stroke-width="2" fill="none" stroke-linecap="round"/>
  
  <!-- T letter for TradeLab -->
  <text x="16" y="12" font-family="Arial, sans-serif" font-size="12" font-weight="bold" fill="#ffffff" text-anchor="middle">T</text>
</svg>
